%% Business flow: uploading media in media-viewer (Express + object storage).
%% Reconstructed from POST /upload, requireAuth, the file check, PutObject, and
%% the response. Object storage is an implementation detail, not a participant.
bpmn LR
  pool "Customer"
    start c0 "Upload needed"
    task:user c1 "Submit media file"
    end c2 "Upload submitted"
  pool "Media Viewer"
    start message s1 "Receive upload request"
    xor g1 "Signed in?"
    xor g2 "File attached?"
    task:service t1 "Store media file"
    task:service t2 "Confirm upload"
    end e1 "Media uploaded"
    end e2 "Sign-in required"
    end e3 "File required"
  c0 --> c1 --> c2
  c1 ==>|"Upload request"| s1
  s1 --> g1
  g1 -- "Yes" --> g2
  g1 -->|default| e2
  g2 -- "Yes" --> t1 --> t2 --> e1
  g2 -->|default| e3
