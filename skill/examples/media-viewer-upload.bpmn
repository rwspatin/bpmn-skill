<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_bpmn" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant___pool_media_viewer" name="Media Viewer" processRef="Process___pool_media_viewer" />
    <bpmn:participant id="Participant___pool_object_storage" name="Object storage" processRef="Process___pool_object_storage" />
    <bpmn:messageFlow id="__flow_8" sourceRef="t1" targetRef="o1" />
  </bpmn:collaboration>
  <bpmn:process id="Process___pool_media_viewer" isExecutable="false">
    <bpmn:startEvent id="s1" name="Upload requested">
      <bpmn:outgoing>__flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g1" name="Signed in?" default="__flow_3">
      <bpmn:incoming>__flow_1</bpmn:incoming>
      <bpmn:outgoing>__flow_2</bpmn:outgoing>
      <bpmn:outgoing>__flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g2" name="File attached?" default="__flow_7">
      <bpmn:incoming>__flow_2</bpmn:incoming>
      <bpmn:outgoing>__flow_4</bpmn:outgoing>
      <bpmn:outgoing>__flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t1" name="Store file in bucket">
      <bpmn:incoming>__flow_4</bpmn:incoming>
      <bpmn:outgoing>__flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="t2" name="Open project page">
      <bpmn:incoming>__flow_5</bpmn:incoming>
      <bpmn:outgoing>__flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Upload complete">
      <bpmn:incoming>__flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Sent to sign-in">
      <bpmn:incoming>__flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e3" name="No file, back to home">
      <bpmn:incoming>__flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="__flow_1" sourceRef="s1" targetRef="g1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_2" name="signed in" sourceRef="g1" targetRef="g2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">signed in</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_3" sourceRef="g1" targetRef="e2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_4" name="file present" sourceRef="g2" targetRef="t1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">file present</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_5" sourceRef="t1" targetRef="t2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_6" sourceRef="t2" targetRef="e1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_7" sourceRef="g2" targetRef="e3"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="Process___pool_object_storage" isExecutable="false">
    <bpmn:task id="o1" name="Persist object">
    </bpmn:task>
  </bpmn:process>
