<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_bpmn" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant___pool_customer" name="Customer" processRef="Process___pool_customer" />
    <bpmn:participant id="Participant___pool_shop" name="Shop" processRef="Process___pool_shop" />
    <bpmn:messageFlow id="__flow_9" name="Order" sourceRef="c1" targetRef="s1" />
  </bpmn:collaboration>
  <bpmn:process id="Process___pool_customer" isExecutable="false">
    <bpmn:startEvent id="c0" name="Order needed">
      <bpmn:outgoing>__flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="c1" name="Submit order">
      <bpmn:incoming>__flow_1</bpmn:incoming>
      <bpmn:outgoing>__flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="c2" name="Order submitted">
      <bpmn:incoming>__flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="__flow_1" sourceRef="c0" targetRef="c1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_2" sourceRef="c1" targetRef="c2"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="Process___pool_shop" isExecutable="false">
    <bpmn:laneSet id="LaneSet___pool_shop">
      <bpmn:lane id="__lane_sales" name="Sales">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="__lane_warehouse" name="Warehouse">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Receive order">
      <bpmn:outgoing>__flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s1_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Review order">
      <bpmn:incoming>__flow_3</bpmn:incoming>
      <bpmn:outgoing>__flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Items available?" default="__flow_8">
      <bpmn:incoming>__flow_4</bpmn:incoming>
      <bpmn:outgoing>__flow_5</bpmn:outgoing>
      <bpmn:outgoing>__flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t2" name="Pick and pack order">
      <bpmn:incoming>__flow_5</bpmn:incoming>
      <bpmn:outgoing>__flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t3" name="Dispatch order">
      <bpmn:incoming>__flow_6</bpmn:incoming>
      <bpmn:outgoing>__flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1" name="Order shipped">
      <bpmn:incoming>__flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Order backordered">
      <bpmn:incoming>__flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="__flow_3" sourceRef="s1" targetRef="t1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_4" sourceRef="t1" targetRef="g1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_5" name="Yes" sourceRef="g1" targetRef="t2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_6" sourceRef="t2" targetRef="t3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_7" sourceRef="t3" targetRef="e1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="__flow_8" sourceRef="g1" targetRef="e2"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant___pool_customer" bpmnElement="Participant___pool_customer" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="540" height="120" />
